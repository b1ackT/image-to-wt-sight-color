// Image to WT Sight Color
drawCentralLineVert:b=no
drawCentralLineHorz:b=no
drawSightMask:b=no
drawDistanceCorrection:b=no
crosshairColor:c=255, 255, 255, 255
crosshairLightColor:c=255, 255, 255, 255
matchExpClass { exp_tank:b=yes; exp_heavy_tank:b=yes; exp_tank_destroyer:b=yes; exp_SPAA:b=yes; }
crosshair_distances {}
crosshair_hor_ranges {}
drawQuads {
  quad {
    tl:p2=-0.6, -0.12
    tr:p2=-0.36, -0.12
    br:p2=-0.36, 0.12
    bl:p2=-0.6, 0.12
    thousandth:b=no
    move:b=no
  }
  quad {
    tl:p2=-0.28, -0.12
    tr:p2=-0.04, -0.12
    br:p2=-0.04, 0.12
    bl:p2=-0.28, 0.12
    thousandth:b=no
    move:b=no
  }
  quad {
    tl:p2=0.04, -0.12
    tr:p2=0.28, -0.12
    br:p2=0.28, 0.12
    bl:p2=0.04, 0.12
    thousandth:b=no
    move:b=no
  }
  quad {
    tl:p2=0.36, -0.12
    tr:p2=0.6, -0.12
    br:p2=0.6, 0.12
    bl:p2=0.36, 0.12
    thousandth:b=no
    move:b=no
  }
}
